# 复制为 .env；Compose 内部使用服务名，不要替换成 localhost。
DATABASE_URL=postgresql+asyncpg://fanjuwu:fanjuwu@postgres:5432/fanjuwu
POSTGRES_USER=fanjuwu
POSTGRES_PASSWORD=fanjuwu
POSTGRES_DB=fanjuwu
REDIS_URL=redis://redis:6379/0
MEILI_URL=http://meilisearch:7700
# 部署到公网前替换下面的开发口令（至少 16 字符）与数据库口令。
MEILI_MASTER_KEY=fanjuwu-local-development-key
# 请改为自己的项目标识与联系方式。
BANGUMI_USER_AGENT=yourname/fanjuwu (https://github.com/yourname/fanjuwu)
# 可选；NSFW 条目实时 API 访问需要 Bangumi token。
BANGUMI_ACCESS_TOKEN=
# OpenAI 兼容服务；可换成 DeepSeek、通义千问等的 /v1 地址。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 向量服务独立配置；同一服务也需填独立 key，支持不计费关闭。
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# pgvector vector 的 HNSW cosine 索引支持 1–2000 维，默认 1536。
# 变更维度必须新建数据库或自行迁移现有向量列和索引。
EMBEDDING_DIM=1536
# 评分人数至少达到此阈值才生成向量。
EMBED_MIN_COLLECTS=50
# 可选；不配置则联网工具明确返回未启用。
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
TZ=Asia/Shanghai
# 浏览器使用同源 /api，Next.js 在服务器转发到 backend。
NEXT_PUBLIC_API_BASE=/api
# true 仅展示设计包中虚构的示例作品与对话；正式部署保持 false。
NEXT_PUBLIC_DEMO_MODE=false
API_INTERNAL_URL=http://backend:8000
# 仅前端从宿主机开放端口。反向代理部署时可更改。
FRONTEND_PORT=3000
# API 与 OpenAPI 文档仅绑定宿主机回环地址。
BACKEND_PORT=8000
# JSON 数组；同源代理无需额外跨域配置。
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# 信任的内部代理网段；仅这些地址可提供被 Next.js 覆写的客户端 IP。
TRUSTED_PROXY_CIDRS=["172.16.0.0/12","10.0.0.0/8"]
## Personal catalog enrichment (backend only; public reads need Client ID, not OAuth).
MYANIMELIST_CLIENT_ID=
MYANIMELIST_CLIENT_SECRET=
EXTERNAL_CATALOG_ENABLED=true
MYANIMELIST_ENABLED=true
KITSU_ENABLED=true
ANILIST_ENABLED=true
EXTERNAL_CATALOG_TIMEOUT=8
EXTERNAL_CATALOG_TTL=86400
